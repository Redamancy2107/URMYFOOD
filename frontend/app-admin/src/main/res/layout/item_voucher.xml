<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?selectableItemBackground">

    <TextView android:id="@+id/tv_code" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/dark_green" android:textStyle="bold" android:textSize="14sp"/>
    <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:textColor="@color/text_primary" android:textSize="13sp"/>
    <TextView android:id="@+id/tv_discount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/mint_green" android:textStyle="bold" android:textSize="13sp"/>
    <TextView android:id="@+id/tv_min_order" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="13sp"/>
    <TextView android:id="@+id/tv_expiry" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="13sp"/>
    
    <ImageView
        android:id="@+id/btn_delete"
        android:layout_width="50dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/error_red"
        android:padding="4dp"
        android:scaleType="centerInside"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
</LinearLayout>
