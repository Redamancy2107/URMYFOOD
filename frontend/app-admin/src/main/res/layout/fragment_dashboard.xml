                    </LinearLayout>
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

                    <!-- Row 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="The Coffee House" android:textColor="@color/text_primary" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="Nguyễn Văn B" android:textColor="@color/text_secondary"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Đồ uống" android:textColor="@color/text_secondary"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="45,800,000 đ" android:textColor="@color/text_primary" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="● Hoạt động" android:textColor="@color/mint_green" android:textStyle="bold"/>
                        <ImageView android:layout_width="40dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_more" app:tint="@color/text_secondary"/>
                    </LinearLayout>

                </LinearLayout>

