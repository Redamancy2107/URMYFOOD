                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="Thao tác" android:textColor="@color/text_secondary" android:textStyle="bold"/>
                    </LinearLayout>
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

                    <!-- Row 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
