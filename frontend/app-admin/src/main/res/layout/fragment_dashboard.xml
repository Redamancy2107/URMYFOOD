<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:id="@+id/ll_sidebar"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_rounded"
                android:padding="8dp"
                android:src="@drawable/ic_logo"
                app:tint="@color/dark_green" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URMYFOOD"
                    android:textColor="@color/dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HỆ THỐNG QUẢN TRỊ"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Menu Items -->
                <LinearLayout android:id="@+id/menu_tong_quan" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_menu_item_active" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/dark_green"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Tổng quan" android:textColor="@color/dark_green" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_duyet_doi_tac" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Duyệt đối tác" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_kiem_duyet" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_view" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Kiểm duyệt nội dung" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_quan_ly_user" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Quản lý người dùng" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_quan_ly_cua_hang" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_mapmode" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Quản lý cửa hàng" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>
                
                <LinearLayout android:id="@+id/menu_ma_giam_gia" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Mã giảm giá" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_bao_cao" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_sort_alphabetically" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Báo cáo" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/menu_cai_dat" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/text_secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cài đặt" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/border_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_xuat_bao_cao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Xuất báo cáo"
            android:textColor="@color/white"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:backgroundTint="@color/dark_green"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:id="@+id/ll_ho_tro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_help" app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Hỗ trợ" android:textColor="@color/text_secondary" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_dang_xuat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_revert" app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Đăng xuất" android:textColor="@color/text_secondary" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/sidebar_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/border_color"
        app:layout_constraintStart_toEndOf="@id/ll_sidebar" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Topbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="300dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="Tìm kiếm đơn hàng, đối tác..."
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_tab_hom_nay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hôm nay"
                    android:textColor="@color/mint_green"
                    android:textStyle="bold"
                    android:padding="8dp"/>
                <TextView
                    android:id="@+id/tv_tab_tuan_nay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuần này"
                    android:textColor="@color/text_secondary"
                    android:padding="8dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:id="@+id/tv_tab_thang_nay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tháng này"
                    android:textColor="@color/text_secondary"
                    android:padding="8dp"
                    android:layout_marginStart="8dp"/>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/border_color" android:layout_marginHorizontal="16dp"/>

                <ImageView android:id="@+id/iv_noti" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_popup_reminder" app:tint="@color/text_secondary" />
                <ImageView android:id="@+id/iv_message" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@android:drawable/sym_action_chat" app:tint="@color/text_secondary" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="24dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/sym_def_app_icon"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nguyễn Đại Hưng" android:layout_marginStart="8dp" android:textColor="@color/text_primary" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 4 Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="4">
                
                <!-- Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_green" android:padding="4dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="@color/mint_green"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="@drawable/bg_badge_green" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="↗ 12.5%" android:textColor="@color/mint_green" android:textSize="12sp" android:textStyle="bold"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tổng doanh thu" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1,284,500,000 đ" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_green" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" app:tint="@color/mint_green"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="@drawable/bg_badge_green" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="↗ 8.2%" android:textColor="@color/mint_green" android:textSize="12sp" android:textStyle="bold"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Đơn hàng mới" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="452 đơn" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_green" android:padding="4dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/mint_green"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="@drawable/bg_badge_green" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="↗ 15.4%" android:textColor="@color/mint_green" android:textSize="12sp" android:textStyle="bold"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Người dùng mới" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1,240" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_green" android:padding="4dp" android:src="@android:drawable/ic_menu_mapmode" app:tint="@color/mint_green"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="@drawable/bg_badge_green" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="↗ 4.1%" android:textColor="@color/mint_green" android:textSize="12sp" android:textStyle="bold"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Shop đang hoạt động" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="86 shop" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Chart & Activity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="3">
                
                <!-- Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_chart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tăng trưởng doanh thu" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theo tuần ▾" android:layout_alignParentEnd="true" android:background="@drawable/bg_input" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textColor="@color/text_secondary"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thống kê 7 ngày gần nhất" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        
                        <!-- Chart Placeholder Area -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="24dp" android:background="@color/sidebar_active_bg">
                            <!-- Draw a simple curved shape using a vector drawable or just leave a static text -->
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="[Biểu đồ đường mượt mà]" android:textColor="@color/mint_green" android:gravity="center" android:textStyle="bold"/>
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Activity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_activity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoạt động gần đây" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem tất cả" android:layout_alignParentEnd="true" android:textColor="@color/mint_green"/>
                        </RelativeLayout>

                        <!-- Activity Items -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/sym_def_app_icon"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nguyễn Văn An" android:textColor="@color/text_primary" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã đăng ký tài khoản đối tác mới" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐANG XỬ LÝ" android:textColor="@color/mint_green" android:textSize="10sp" android:background="@drawable/bg_badge_green" android:paddingHorizontal="4dp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/sym_def_app_icon"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trần Minh Khang" android:textColor="@color/text_primary" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoàn thành đơn hàng #ORD-9921" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Bottom Table -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="48dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cửa hàng mới nhất" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
