<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.urmyfood.user.presentation.auth.splash.SplashFragment"
        android:label="fragment_auth_splash"
        tools:layout="@layout/fragment_auth_splash">
        <action
            android:id="@+id/action_splashFragment_to_chooseRoleFragment"
            app:destination="@id/chooseRoleFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/chooseRoleFragment"
        android:name="com.urmyfood.user.presentation.auth.chooserole.ChooseRoleFragment"
        android:label="fragment_auth_choose_role"
        tools:layout="@layout/fragment_auth_choose_role">
        <action
            android:id="@+id/action_chooseRoleFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_chooseRoleFragment_to_signupCustomerFragment"
            app:destination="@id/signupCustomerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.urmyfood.user.presentation.auth.login.LoginFragment"
        android:label="fragment_auth_login"
        tools:layout="@layout/fragment_auth_login">
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_loginFragment_to_signupCustomerFragment"
            app:destination="@id/signupCustomerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"
            app:popUpTo="@id/chooseRoleFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupCustomerFragment"
        android:name="com.urmyfood.user.presentation.auth.register.SignupCustomerFragment"
        android:label="fragment_auth_signup_customer"
        tools:layout="@layout/fragment_auth_signup_customer">
        <action
            android:id="@+id/action_signupCustomerFragment_to_otpFragment"
            app:destination="@id/otpFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_signupCustomerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"
            app:popUpTo="@id/chooseRoleFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.urmyfood.user.presentation.auth.forgotpass.ForgotPasswordFragment"
        android:label="fragment_auth_forgot_password"
        tools:layout="@layout/fragment_auth_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_otpFragment"
            app:destination="@id/otpFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.urmyfood.user.presentation.auth.otp.OtpFragment"
        android:label="fragment_auth_otp"
        tools:layout="@layout/fragment_auth_otp">
        <argument
            android:name="otpSource"
            app:argType="string"
            android:defaultValue="forgot_password" />
        <action
            android:id="@+id/action_otpFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_otpFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/chooseRoleFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.urmyfood.user.presentation.auth.forgotpass.ResetPasswordFragment"
        android:label="fragment_auth_reset_password"
        tools:layout="@layout/fragment_auth_reset_password">
        <action
            android:id="@+id/action_resetPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/chooseRoleFragment"
            app:popUpToInclusive="false" />
    </fragment>
</navigation>