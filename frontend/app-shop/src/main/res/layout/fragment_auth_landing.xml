<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    tools:context=".presentation.auth.landing.LandingFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/heroGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.68" />

    <ImageView
        android:id="@+id/ivHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/landing_shop_hero"
        app:layout_constraintBottom_toTopOf="@id/heroGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/heroScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_landing_hero_scrim"
        app:layout_constraintBottom_toBottomOf="@id/ivHero"
        app:layout_constraintEnd_toEndOf="@id/ivHero"
        app:layout_constraintStart_toStartOf="@id/ivHero"
        app:layout_constraintTop_toTopOf="@id/ivHero" />

    <TextView
        android:id="@+id/tvHeroBrand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.03"
        android:text="@string/landing_brand"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="URMYFOOD Shop" />

    <TextView
        android:id="@+id/tvHeroSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/landing_hero_subtitle"
        android:textColor="@color/landing_on_photo_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/tvHeroBrand"
        app:layout_constraintStart_toStartOf="@id/tvHeroBrand"
        app:layout_constraintTop_toBottomOf="@id/tvHeroBrand"
        tools:text="Van hanh cua hang gon gang hon moi ngay" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_landing_bottom_panel"
        android:elevation="10dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/heroGuideline">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/landing_login"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toTopOf="@id/btnRegister"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/landing_register"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
