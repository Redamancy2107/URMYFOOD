<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.urmyfood.shop.presentation.auth.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_auth_splash">
        <action
            android:id="@+id/action_splash_to_landing"
            app:destination="@id/landingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_main"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/landingFragment"
        android:name="com.urmyfood.shop.presentation.auth.landing.LandingFragment"
        android:label="LandingFragment"
        tools:layout="@layout/fragment_auth_landing">
        <action
            android:id="@+id/action_landing_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_landing_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.urmyfood.shop.presentation.auth.login.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_auth_login">
        <action
            android:id="@+id/action_login_to_main"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.urmyfood.shop.presentation.auth.register.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_auth_register">
        <action
            android:id="@+id/action_register_to_otp"
            app:destination="@id/otpFragment" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.urmyfood.shop.presentation.auth.forgotpass.ForgotPasswordFragment"
        android:label="ForgotPasswordFragment"
        tools:layout="@layout/fragment_auth_forgot_password">
        <action
            android:id="@+id/action_forgotPassword_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.urmyfood.shop.presentation.auth.forgotpass.OtpFragment"
        android:label="OtpFragment"
        tools:layout="@layout/fragment_auth_otp">
        <argument
            android:name="otpSource"
            app:argType="string"
            android:defaultValue="forgot_password" />
        <action
            android:id="@+id/action_otp_to_resetPassword"
            app:destination="@id/resetPasswordFragment" />
        <action
            android:id="@+id/action_otp_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_otp_to_registration_flow"
            app:destination="@id/nav_registration_flow"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <navigation
        android:id="@+id/nav_registration_flow"
        app:startDestination="@id/registrationStep1Fragment">

        <fragment
            android:id="@+id/registrationStep1Fragment"
            android:name="com.urmyfood.shop.presentation.auth.registration.step1.RegistrationStep1Fragment"
            android:label="RegistrationStep1Fragment"
            tools:layout="@layout/fragment_registration_step1">
            <action
                android:id="@+id/action_step1_to_map"
                app:destination="@id/mapPickerFragment" />
            <action
                android:id="@+id/action_step1_to_step2"
                app:destination="@id/registrationStep2Fragment" />
        </fragment>

        <fragment
            android:id="@+id/mapPickerFragment"
            android:name="com.urmyfood.shop.presentation.auth.map.MapPickerFragment"
            android:label="MapPickerFragment"
            tools:layout="@layout/fragment_map_picker" />

        <fragment
            android:id="@+id/registrationStep2Fragment"
            android:name="com.urmyfood.shop.presentation.auth.registration.step2.RegistrationStep2Fragment"
            android:label="RegistrationStep2Fragment"
            tools:layout="@layout/fragment_registration_step2">
            <action
                android:id="@+id/action_step2_to_step3"
                app:destination="@id/registrationStep3Fragment" />
        </fragment>

        <fragment
            android:id="@+id/registrationStep3Fragment"
            android:name="com.urmyfood.shop.presentation.auth.registration.step3.RegistrationStep3Fragment"
            android:label="RegistrationStep3Fragment"
            tools:layout="@layout/fragment_registration_step3">
            <action
                android:id="@+id/action_step3_to_verification_pending"
                app:destination="@id/verificationPendingFragment"
                app:popUpTo="@id/landingFragment"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

    <fragment
        android:id="@+id/verificationPendingFragment"
        android:name="com.urmyfood.shop.presentation.auth.registration.VerificationPendingFragment"
        android:label="VerificationPendingFragment"
        tools:layout="@layout/fragment_verification_pending">
        <action
            android:id="@+id/action_verification_pending_to_main"
            app:destination="@id/mainFragment" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.urmyfood.shop.presentation.auth.forgotpass.ResetPasswordFragment"
        android:label="ResetPasswordFragment"
        tools:layout="@layout/fragment_auth_reset_password">
        <action
            android:id="@+id/action_resetPassword_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.urmyfood.shop.presentation.main.MainContainerFragment"
        android:label="MainContainerFragment"
        tools:layout="@layout/fragment_main_container" />

</navigation>
